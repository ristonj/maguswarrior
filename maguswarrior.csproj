<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <TargetFrameworks Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFrameworks>
    <RootNamespace>MagusWarrior</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <!-- Godot's Android export does not import Godot.SourceGenerators.props, so the
       CompilerVisibleProperty registrations for GodotProjectDir never reach the source
       generator — it sees the property as absent and aborts (CS8785, 'GodotProjectDir is
       null or empty'), which silently disables _Ready/_Process/signal dispatch on device.
       The value itself resolves fine (cf. build_property.ProjectDir); it just needs to be
       made compiler-visible. Register it explicitly here. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="GodotProjectDir" />
    <CompilerVisibleProperty Include="GodotProjectDirBase64" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
</Project>
